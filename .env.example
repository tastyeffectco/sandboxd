# sandboxd configuration. Copy to .env (install.sh does this for you):
#   cp .env.example .env
# All values have sensible defaults; the stack runs with an empty .env.

# ── Preview routing ──────────────────────────────────────────────────
# Domain preview URLs hang off. "localhost" needs no DNS/TLS: browsers
# resolve *.localhost to 127.0.0.1, so previews work out of the box at
#   http://s-<id>-<port>.preview.localhost:${HTTP_PORT}
# For a public deployment, set a real wildcard domain and switch to TLS
# (see README "Production / TLS").
PREVIEW_DOMAIN=localhost
PREVIEW_ENTRYPOINT=web
PREVIEW_TLS=false
# Behind something ELSE that terminates TLS (Cloudflare Tunnel, Caddy, Nginx,
# a reverse tunnel)? Keep PREVIEW_TLS=false (Traefik stays plain HTTP) and set
# PREVIEW_URL_SCHEME=https so the console hands out https:// preview URLs it
# can iframe. The proxy in front must listen on that scheme's default port
# (443 for https): with an explicit scheme, HTTP_PORT is not part of the URL.
# Empty = derived from PREVIEW_TLS.
PREVIEW_URL_SCHEME=

# Hostname layout under PREVIEW_DOMAIN.
#   nested (default)  s-<id>-<port>.preview.<domain>   console.<domain>   api.preview.<domain>
#   flat              s-<id>-<port>[--tag].<domain>    console[--tag].<domain>   api[--tag].<domain>
# With flat, one wildcard certificate *.<domain> covers every host
# (Cloudflare Universal SSL and similar cover only one level); the tag lets
# several sandboxd instances share one domain. PREVIEW_HOST_TAG is only used
# with flat and must match [a-z0-9][a-z0-9-]{0,30}. In flat mode each preview
# host authorises private previews separately (no shared session cookie).
PREVIEW_HOST_STYLE=nested
PREVIEW_HOST_TAG=
# Hostname the console is served on. Empty = console.<PREVIEW_DOMAIN>; set to
# console--<tag>.<domain> when using flat + tag.
CONSOLE_HOST=

# Host port Traefik listens on. Use 80 on a dedicated host; pick another
# (e.g. 8080) if something already owns 80. Preview URLs then include it:
#   http://s-<id>-<port>.preview.localhost:8080
#
# macOS note — Rancher Desktop and Docker Desktop with k3s enabled bind
# port 80 via their built-in Traefik/klipper-lb before sandboxd's Traefik
# can claim it, so preview URLs silently 404. Use HTTP_PORT=8080 (or any
# free port) and restart: docker compose up -d traefik
HTTP_PORT=80
# Host address Traefik's port is published on. 0.0.0.0 (default) makes
# Traefik the public front door. On a server where something else owns
# 80/443 (managed Caddy, your nginx or Caddy — install.sh --front), Traefik
# is only the internal router: SANDBOXD_HTTP_BIND=127.0.0.1 with HTTP_PORT=8088,
# and PREVIEW_URL_SCHEME=https so public URLs carry no :8088.
SANDBOXD_HTTP_BIND=0.0.0.0

# ── Front door (install.sh --front) ──────────────────────────────────
# Recorded by install.sh --front: caddy (sandboxd runs Caddy on 80/443,
# compose profile "caddy"), existing (your nginx/Caddy forwards to
# 127.0.0.1:8088), manual (you wire it up), or empty (Traefik is the front
# door, the default for desktop and local installs).
SANDBOXD_FRONT=
# Compose profiles to start (e.g. caddy). install.sh passes them explicitly;
# this keeps plain `docker compose up -d` consistent with the install.
# COMPOSE_PROFILES=
# Traefik middleware applied to production app routers (never to previews).
# Empty = none. sandbox-ratelimit@file limits per client IP when Traefik
# faces clients directly; sandbox-ratelimit-proxied@file trusts the one
# front door in front of it (traefik/dynamic/ratelimit.yml).
SANDBOXD_RATELIMIT_MIDDLEWARE=

# ── Images & network ─────────────────────────────────────────────────
# A clean stable release checkout can pull verified GHCR images when cosign
# is installed. Development checkouts build locally. --build always builds.
# Leave the tag blank to match the checkout; --pull requires an exact match.
SANDBOXD_IMAGE_TAG=
# Optional custom image names; these select the source-build path.
SANDBOXD_IMAGE=
SANDBOXD_CONTROL_PLANE_IMAGE=
SANDBOXD_CONSOLE_IMAGE=
SANDBOXD_NETWORK=sandboxd_net

# ── Runtime (gVisor, opt-in) ─────────────────────────────────────────
# Container runtime for sandboxes. Empty = Docker default (runc).
# Set "runsc" to run every sandbox under gVisor for stronger kernel
# isolation. Requires runsc installed + registered in daemon.json with
# runtimeArgs ["--host-uds=create"]. See docs/gvisor.md.
SANDBOXD_RUNTIME=
# Resolvers for sandboxes (CSV). Only used when SANDBOXD_RUNTIME=runsc
# (gVisor can't reach Docker's embedded DNS). Default: 1.1.1.1,8.8.8.8
SANDBOXD_DNS=

# ── Storage ──────────────────────────────────────────────────────────
# Workspaces, SQLite state and the shared access log live here. MUST be
# an absolute path; it is bind-mounted host:container symmetric (see
# docker-compose.yml). NOTE: the OSS build stores each workspace as a
# plain directory — there is NO hard per-workspace disk quota.
SANDBOXD_DATA_DIR=/var/lib/sandboxd
SANDBOXD_LOG_DIR=/var/lib/sandboxd/log

# Where the control-plane API is published on the host. The default
# avoids the common 9000 clash; the upstream backend / your scripts talk
# to it here. Set to e.g. 0.0.0.0:9090 to expose on the LAN (then you
# SHOULD enable auth below).
SANDBOXD_API_BIND=127.0.0.1:9090

# ── API auth (sandboxd /v1) ──────────────────────────────────────────
# ON by default. Every /v1 request needs a console session or a bearer API key —
# uniformly, with no loopback bypass. The console manages keys in Settings →
# Security; SANDBOXD_API_TOKENS is the env "bootstrap" key (NAME=VALUE, comma-
# separated) the installer seeds + prints so scripts work immediately:
#   SANDBOXD_API_TOKENS=default=sk_...      # printed by install.sh
# Rotate it by editing this line (SIGHUP reloads it) or mint a key in the UI.
# Set SANDBOXD_API_AUTH_DISABLED=true only as an explicit rollback (opens the
# API and trips the console's "your API is open" warning).
SANDBOXD_API_AUTH_DISABLED=false
SANDBOXD_API_TOKENS=

# ── Coding agents ────────────────────────────────────────────────────
# Agent used for tasks that don't name one (opencode | claude-code).
SANDBOXD_DEFAULT_AGENT=opencode
# Which OpenCode Zen endpoint opencode routes through the auth proxy:
#   zen   = pay-as-you-go, full catalog (needs a positive wallet balance)
#   zengo = the OpenCode "go" subscription's included models (no balance)
# See docs/agent-auth.md → "OpenCode Zen: subscription vs pay-as-you-go".
SANDBOXD_OPENCODE_ZEN_PATH=zen
# Credential-injecting auth proxy: agents reach their provider through this so
# NO API key / OAuth token ever enters a sandbox. Empty = disable (legacy mount).
# SANDBOXD_AGENT_PROXY_URL=http://sandboxd:9100
# Optional global default model for opencode tasks (e.g. opencode/glm-5).
# SANDBOXD_OPENCODE_MODEL=
# MiniMax direct endpoints (a connected MiniMax API key, Settings → AI Agents,
# is injected by the auth proxy). Global: api.minimax.io; China: api.minimaxi.com.
# MiniMax-M3.1-Flash and MiniMax-M3 (plus explicit legacy MiniMax-M2.7
# requests) route to the OpenAI-compatible endpoint
# (/v1); Anthropic-compatible (/anthropic) traffic is also proxied. Pick the
# China region with SANDBOXD_MINIMAX_REGION=cn_zh (default global_en).
# SANDBOXD_MINIMAX_REGION=global_en

# ── Console login ────────────────────────────────────────────────────
# The web console (docker compose --profile console) is protected by an
# app-level login owned by the control plane: on first visit you create a
# password; it issues an HttpOnly session cookie. Nothing to configure here —
# no Traefik basic-auth, no htpasswd. Change it anytime in Settings → Security.

# Master key for encrypting sensitive app config/secrets at rest
# (base64 of 32 bytes). Leave empty to auto-generate a 0600 keyfile at
# <data dir>/secrets.key. Back this up — losing it makes secrets
# unrecoverable; treat it as sensitive as the secrets themselves.
SANDBOXD_SECRETS_KEY=

# ── Resource policy (advanced) ───────────────────────────────────────
# Write cgroup v2 memory.high after start (soft throttle). Needs host
# cgroup access the control-plane container usually lacks, so it is OFF
# by default; the hard --memory ceiling on each sandbox still applies.
SANDBOXD_SET_MEMORY_HIGH=false

# Idle window before a sandbox is stopped (docker stop) to free RAM.
# 2100s = 35 min. Workspace is preserved; next request wakes it.
SANDBOXD_IDLE_THRESHOLD_SECONDS=2100

# ── Observability (Phase 5) ──────────────────────────────────────────
# The durable activity timeline (app_events table) is append-only and
# lives in the control-plane SQLite DB. Retention is NOT pruned yet; the
# table is small at current volume. Future knob (not implemented):
#   SANDBOXD_EVENT_RETENTION_DAYS  — delete app_events older than N days.
# Until then the timeline grows unbounded; that's fine for current use.

# ── In-place upgrades from the console ────────────────────────────────
# install.sh records the host path of this checkout so the console's
# "Upgrade now" can launch a detached upgrader that runs ./upgrade.sh.
# Leave empty to disable (the console then points at the CLI).
SANDBOXD_SRC_DIR=

# ── Anonymous telemetry ───────────────────────────────────────────────
# A daily heartbeat with bucketed counts and enumerated settings — never
# hostnames, IPs, paths, names or content. Every field: docs/telemetry.md.
# Opt out with either line (both are honoured):
#   SANDBOXD_TELEMETRY=off
#   DO_NOT_TRACK=1
SANDBOXD_TELEMETRY=
# Send to your own PostHog instead of the project's (optional):
SANDBOXD_POSTHOG_HOST=
SANDBOXD_POSTHOG_KEY=

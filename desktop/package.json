{
  "name": "sandboxd-desktop",
  "version": "0.3.27",
  "private": true,
  "description": "The native desktop client for the sandboxd engine",
  "author": "sandboxd contributors",
  "license": "MIT",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "build:ui": "node scripts/build-ui.cjs",
    "test": "node --test --test-timeout=120000 test/*.test.cjs",
    "pack": "electron-builder --dir --publish never",
    "dist": "electron-builder --publish never",
    "smoke": "node scripts/smoke.cjs",
    "smoke:package": "node scripts/smoke-package.cjs"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "io.sandboxd.desktop",
    "productName": "sandboxd",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**",
      "ui/**",
      "package.json",
      "!node_modules/cpu-features/**",
      "!node_modules/nan/**",
      "!node_modules/buildcheck/**",
      "!node_modules/ssh2/lib/protocol/crypto/src/**",
      "!node_modules/ssh2/lib/protocol/crypto/binding.gyp",
      "!node_modules/ssh2/install.js"
    ],
    "asar": true,
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Development",
      "icon": "build/icon.png"
    },
    "artifactName": "sandboxd-desktop-${version}-${os}-${arch}.${ext}",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    }
  },
  "dependencies": {
    "ssh2": "1.17.0"
  }
}
